{
  "name": "edge-impulse-mpu",
  "version": "1.0.0",
  "description": "Edge Impulse impulse for FIREALERT MPU idle/walk",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "libArchive": false,
    "flags": [
      "-I.",
      "-Iedge-impulse-sdk",
      "-Iedge-impulse-sdk/classifier",
      "-Iedge-impulse-sdk/dsp",
      "-Iedge-impulse-sdk/dsp/kissfft",
      "-Iedge-impulse-sdk/dsp/dct",
      "-Iedge-impulse-sdk/porting",
      "-Iedge-impulse-sdk/CMSIS/DSP/Include",
      "-Iedge-impulse-sdk/CMSIS/Core/Include",
      "-Iedge-impulse-sdk/CMSIS/NN/Include",
      "-Imodel-parameters",
      "-Itflite-model",
      "-D__CMSIS_GCC_H",
      "-DEI_CLASSIFIER_ALLOCATION_STATIC=1",
      "-DTF_LITE_STATIC_MEMORY=1"
    ],
    "srcFilter": [
      "+<*>",
      "-<.git/>",
      "-<edge-impulse-sdk/CMSIS/DSP/Source/>",
      "-<edge-impulse-sdk/CMSIS/NN/Source/>",
      "-<edge-impulse-sdk/CMSIS/NN/Tests/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/kernels/ethos_u/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/kernels/cm0p/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/testing/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/benchmarks/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/examples/>",
      "-<edge-impulse-sdk/tensorflow/lite/micro/models/>",
      "-<edge-impulse-sdk/porting/alif/>",
      "-<edge-impulse-sdk/porting/ambiq/>",
      "-<edge-impulse-sdk/porting/android/>",
      "-<edge-impulse-sdk/porting/brickml/>",
      "-<edge-impulse-sdk/porting/ceva-npn/>",
      "-<edge-impulse-sdk/porting/clib/>",
      "-<edge-impulse-sdk/porting/espressif/>",
      "-<edge-impulse-sdk/porting/ethos-core-driver/>",
      "-<edge-impulse-sdk/porting/himax/>",
      "-<edge-impulse-sdk/porting/himax-we2/>",
      "-<edge-impulse-sdk/porting/iar/>",
      "-<edge-impulse-sdk/porting/infineon-psoc62/>",
      "-<edge-impulse-sdk/porting/mbed/>",
      "-<edge-impulse-sdk/porting/mingw32/>",
      "-<edge-impulse-sdk/porting/open-cmsis/>",
      "-<edge-impulse-sdk/porting/particle/>",
      "-<edge-impulse-sdk/porting/posix/>",
      "-<edge-impulse-sdk/porting/raspberry/>",
      "-<edge-impulse-sdk/porting/renesas-ra/>",
      "-<edge-impulse-sdk/porting/seeed-vision-ai/>",
      "-<edge-impulse-sdk/porting/silabs/>",
      "-<edge-impulse-sdk/porting/sony/>",
      "-<edge-impulse-sdk/porting/stm32-cubeai/>",
      "-<edge-impulse-sdk/porting/synaptics/>",
      "-<edge-impulse-sdk/porting/ti/>",
      "-<edge-impulse-sdk/porting/zephyr/>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/TransformFunctions/*fft*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/CommonTables/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/BasicMathFunctions/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/ComplexMathFunctions/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/FastMathFunctions/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/SupportFunctions/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/MatrixFunctions/*.c>",
      "+<edge-impulse-sdk/CMSIS/DSP/Source/StatisticsFunctions/*.c>"
    ]
  }
}
