# Optional. Set the same values on Vercel and in web/.env.local
# to use Upstash Redis or Vercel KV instead of the built-in shared log.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# FIREALERT_SHARED=off

# Neon Postgres (from repo root: neon env pull --file web/.env.local -s postgres)
# DATABASE_URL=                 # pooled — app runtime
# DATABASE_URL_UNPOOLED=        # direct — drizzle migrations
# NEON_BRANCH=production

# Sign-in session cookie (at least 32 characters)
# SESSION_SECRET=use-a-random-string-at-least-32-characters-long

# Local-first telemetry: set off on a site node with no uplink (packets stay sync_status=local).
# FIREALERT_CLOUD_SYNC=on
# FIREALERT_NODE_ID=site-local-1
